{
  "id": "ruby-api-environment",
  "name": "Ruby API (Production)",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://api.rby.one",
      "type": "default",
      "description": "Base URL of the Ruby Developer REST API",
      "enabled": true
    },
    {
      "key": "authMethod",
      "value": "bearer",
      "type": "default",
      "description": "Authentication method: 'bearer' (standard) or 'hmac' (enterprise request-signing)",
      "enabled": true
    },
    {
      "key": "apiKeyId",
      "value": "YOUR_API_KEY_ID",
      "type": "secret",
      "description": "Public API Key ID (e.g. ak_...)",
      "enabled": true
    },
    {
      "key": "apiKeySecret",
      "value": "YOUR_API_KEY_SECRET",
      "type": "secret",
      "description": "API Key Secret for Bearer auth (e.g. as_...)",
      "enabled": true
    },
    {
      "key": "hmacSecret",
      "value": "YOUR_HMAC_SECRET",
      "type": "secret",
      "description": "HMAC Secret for request signing (e.g. hs_...)",
      "enabled": true
    },
    {
      "key": "defaultDomain",
      "value": "rby.one",
      "type": "default",
      "description": "Platform default domain or your verified branded domain",
      "enabled": true
    },
    {
      "key": "shortCode",
      "value": "sample123",
      "type": "default",
      "description": "Sample short code for lookup requests",
      "enabled": true
    },
    {
      "key": "linkPublicId",
      "value": "lnk_sample123",
      "type": "default",
      "description": "Sample link public ID for single link endpoints",
      "enabled": true
    },
    {
      "key": "groupPublicId",
      "value": "grp_sample123",
      "type": "default",
      "description": "Sample group public ID for group endpoints",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
