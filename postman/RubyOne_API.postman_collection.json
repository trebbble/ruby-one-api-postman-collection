              "path": [
                "v1",
                "links",
                "{{linkPublicId}}",
                "stats"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "30",
                  "description": "Timeframe in days (7, 30, 60, 90, 180, 365, 730, 1825)"
                }
              ]
            },
            "description": "Retrieve aggregated clickstream analytics, time series, and categorical breakdowns."
          }
        }
      ]
