{
  "info": {
    "_postman_id": "ruby-developer-api-collection",
    "name": "Ruby Developer API",
    "description": "Official Postman Collection for the Ruby Public Developer REST API v1 — Enterprise URL Shortener, Dynamic QR Codes & Link Management.\n\n### Authentication\nThis collection automatically handles both:\n1. **Basic Bearer Token** (`Authorization: Bearer <key_id>:<key_secret>`)\n2. **Enterprise HMAC-SHA256 Request Signing** (`X-Rby-Key-Id`, `X-Rby-Timestamp`, `X-Rby-Signature`)\n\nSwitch between them by setting the `authMethod` environment variable to `bearer` or `hmac`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ruby API Dual-Authentication Handler",
          "// Supports both Basic Bearer Token and Enterprise HMAC-SHA256 Request Signing",
          "",
          "function setHeader(name, value) {",
          "    if (pm.request.headers.upsert) {",
          "        pm.request.headers.upsert({ key: name, value: value });",
          "    } else {",
          "        pm.request.headers.remove(name);",
          "        pm.request.headers.add({ key: name, value: value });",
          "    }",
          "}",
          "",
          "function removeHeader(name) {",
          "    pm.request.headers.remove(name);",
          "}",
          "",
          "const authMethod = (pm.environment.get(\"authMethod\") || \"bearer\").toLowerCase();",
          "const keyId = pm.environment.get(\"apiKeyId\");",
          "",
          "if (authMethod === \"hmac\") {",
          "    const hmacSecret = pm.environment.get(\"hmacSecret\");",
          "    if (!keyId || !hmacSecret || keyId === \"YOUR_API_KEY_ID\" || hmacSecret === \"YOUR_HMAC_SECRET\") {",
          "        console.warn(\"[Ruby Auth] 'hmac' mode requires 'apiKeyId' and 'hmacSecret' environment variables.\");",
          "    }",
          "",
          "    const timestamp = Math.floor(Date.now() / 1000).toString();",
          "    const method = pm.request.method.toUpperCase();",
          "    ",
          "    // Resolve full path (including /v1) after variable replacement",
          "    let path = \"\";",
          "    try {",
          "        const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString());",
          "        const match = resolvedUrl.match(/^https?:\\/\\/[^\\/]+(\\/[^?#]*)/);",
          "        if (match && match[1]) {",
          "            path = match[1];",
          "        } else {",
          "            path = pm.request.url.getPath();",
          "            if (typeof path === \"string\" && !path.startsWith(\"/\")) path = \"/\" + path;",
          "        }",
          "    } catch (e) {",
          "        path = pm.request.url.getPath();",
          "        if (typeof path === \"string\" && !path.startsWith(\"/\")) path = \"/\" + path;",
          "    }",
          "    ",
          "    // Compute SHA256 hex digest of the raw request body with variables resolved",
          "    const rawBody = pm.request.body && pm.request.body.raw ? pm.variables.replaceIn(pm.request.body.raw) : \"\";",
          "    const cryptoLib = (typeof require === \"function\") ? (function() { try { return require(\"crypto-js\"); } catch(e) { return CryptoJS; } })() : CryptoJS;",
          "    const bodyHash = cryptoLib.SHA256(rawBody).toString(cryptoLib.enc.Hex);",
          "    ",
          "    // Canonical string: \"{timestamp}\\n{METHOD}\\n{path}\\n{body_hash}\"",
          "    const stringToSign = `${timestamp}\\n${method}\\n${path}\\n${bodyHash}`;",
          "    const signature = cryptoLib.HmacSHA256(stringToSign, hmacSecret || \"\").toString(CryptoJS.enc.Hex);",
          "    ",
          "    // Set Ruby HMAC headers",
          "    setHeader(\"X-Rby-Key-Id\", keyId || \"\");",
          "    setHeader(\"X-Rby-Timestamp\", timestamp);",
          "    setHeader(\"X-Rby-Signature\", signature);",
          "    removeHeader(\"Authorization\");",
          "",
          "} else {",
          "    // Basic Bearer Token mode: Authorization: Bearer <key_id>:<key_secret>",
          "    const keySecret = pm.environment.get(\"apiKeySecret\");",
          "    if (!keyId || !keySecret || keyId === \"YOUR_API_KEY_ID\" || keySecret === \"YOUR_API_KEY_SECRET\") {",
          "        console.warn(\"[Ruby Auth] 'bearer' mode requires 'apiKeyId' and 'apiKeySecret' environment variables.\");",
          "    }",
          "",
          "    setHeader(\"Authorization\", `Bearer ${keyId || \"\"}:${keySecret || \"\"}`);",
          "    removeHeader(\"X-Rby-Key-Id\");",
          "    removeHeader(\"X-Rby-Timestamp\");",
          "    removeHeader(\"X-Rby-Signature\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Links",
      "description": "Create, list, inspect, update, delete, and analyze short links.",
      "item": [
        {
          "name": "Create Short Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination_url\": \"https://example.com/summer-promotion\",\n  \"domain\": \"{{defaultDomain}}\",\n  \"title\": \"Summer Campaign Link\",\n  \"utm_source\": \"newsletter\",\n  \"utm_medium\": \"email\",\n  \"utm_campaign\": \"summer_sale\",\n  \"forward_parameters\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "links"
              ]
            },
            "description": "Create a new short link on the default domain (rby.one) or a verified custom domain."
          }
        },
        {
          "name": "List Short Links",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/links?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "links"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size limit (1-100)"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "Cursor from previous page",
                  "disabled": true
                },
                {
                  "key": "domain",
                  "value": "{{defaultDomain}}",
                  "description": "Filter by domain",
                  "disabled": true
                },
                {
                  "key": "group_public_id",
                  "value": "{{groupPublicId}}",
                  "description": "Filter by group",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "true",
                  "description": "Filter active/inactive",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search keyword",
                  "disabled": true
                }
              ]
            },
            "description": "List short links with cursor pagination and optional filters."
          }
        },
        {
          "name": "Lookup Short Link",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/links/lookup?domain={{defaultDomain}}&short_code={{shortCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "links",
                "lookup"
              ],
              "query": [
                {
                  "key": "domain",
                  "value": "{{defaultDomain}}",
                  "description": "Domain name"
                },
                {
                  "key": "short_code",
                  "value": "{{shortCode}}",
                  "description": "Short code or alias"
                }
              ]
            },
            "description": "Resolve short link details by domain and short code combination."
          }
        },
        {
          "name": "Get Short Link by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/links/{{linkPublicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "links",
                "{{linkPublicId}}"
              ]
            },
            "description": "Get detailed metadata and routing rules for a single link by public ID."
          }
        },
        {
          "name": "Update Short Link",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination_url\": \"https://example.com/updated-summer-promotion\",\n  \"title\": \"Updated Summer Campaign Title\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/links/{{linkPublicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "links",
                "{{linkPublicId}}"
              ]
            },
            "description": "Update destination URL, title, targeting rules, password, or active status."
          }
        },
        {
          "name": "Delete Short Link",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/links/{{linkPublicId}}?hard=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "links",
                "{{linkPublicId}}"
              ],
              "query": [
                {
                  "key": "hard",
                  "value": "false",
                  "description": "true for hard purge, false for soft deactivate"
                }
              ]
            },
            "description": "Deactivate (soft delete) or permanently purge (hard delete) a short link."
          }
        },
        {
          "name": "Get Short Link Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/links/{{linkPublicId}}/stats?period=30",
              "host": [
                "{{baseUrl}}"
